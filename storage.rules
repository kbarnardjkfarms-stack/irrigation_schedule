rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /pivotProfiles/{pivotId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner', 'farm_manager', 'irrigation_manager'];
    }
  }
}
