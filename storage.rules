rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /pivotProfiles/{pivotId}/{allPaths=**} {
      allow read: if request.auth != null;
      // Upload / replace: same people as before. Deleting a package file
      // takes farm manager or above.
      allow create, update: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner', 'farm_manager', 'irrigation_manager'];
      allow delete: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner', 'farm_manager'];
    }
  }
}
