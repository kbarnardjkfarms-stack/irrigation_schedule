rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Role/permission helpers -------------------------------------
    // A single source of truth for "who is this person and what can they
    // touch," used by every match block below instead of repeating raw
    // get() calls. Roles, top-down: admin, owner, farm_manager,
    // irrigation_manager, irrigator. Admin/owner can view and edit
    // everything. Farm/irrigation managers can edit only the farm(s) on
    // their profile, view-only elsewhere. Irrigators are view-only by
    // default, unless their profile has canEditSchedule set — that grants
    // schedule editing (not field settings) on their assigned farm(s) only.
    function signedIn() {
      return request.auth != null;
    }
    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myRole() {
      return myData().role;
    }
    function isAdminOrOwner() {
      return myRole() == 'admin' || myRole() == 'owner';
    }
    // Customer logins (role 'customer') are outside staff entirely: they can
    // read only their own published customerViews doc(s), nothing else.
    // They're excluded from every staff module via hasModule() below, and
    // from the shared reference data via isStaff().
    function isCustomer() {
      return myRole() == 'customer';
    }
    function isStaff() {
      return signedIn() && !isCustomer();
    }
    // Agronomy module - Admin, Owner, or Farm manager only. Narrower than
    // isAdminOrOwner() alone, and deliberately excludes Irrigation manager
    // and Irrigator, unlike the farm-scoped functions below.
    function canViewAgronomy() {
      return isAdminOrOwner() || myRole() == 'farm_manager';
    }
    // Contracts module - same audience as Agronomy (Admin, Owner, Farm
    // manager can view); writes are Admin/Owner only, see the match blocks.
    function canViewContracts() {
      return isAdminOrOwner() || myRole() == 'farm_manager';
    }
    // Module access. A profile may carry a `modules` list (e.g.
    // ['irrigation', 'potato-storage']) saying which AIO modules that person
    // can use at all. A profile with NO `modules` field keeps exactly what
    // its role already allowed, so deploying this changes nothing for
    // anyone until an Admin actually sets a list. Admin/Owner always have
    // every module. Module ids: 'irrigation', 'potato-storage', 'agronomy', 'contracts', 'yields', 'harvest', 'seed', 'map'.
    // This is the real enforcement — hiding a tile in the UI is only
    // cosmetic, since anyone could still query Firestore directly.
    // Potato planting staff only ever get the seed module.
    function hasModule(m) {
      let mods = myData().get('modules', null);
      return isAdminOrOwner() || (!isCustomer() && (myRole() != 'planting_staff' || m == 'seed') && (mods == null || m in mods));
    }
    function myFarmIds() {
      return myData().farmIds;
    }
    function fieldFarmId(fieldId) {
      return get(/databases/$(database)/documents/fields/$(fieldId)).data.farmId;
    }
    // Field settings (GPM, etc.) — structural/managerial data. Admin,
    // owner, or a farm/irrigation manager on that specific farm. Never
    // granted by the irrigator schedule-edit override.
    function canEditFarmData(fieldId) {
      let role = myRole();
      return isAdminOrOwner()
        || ((role == 'farm_manager' || role == 'irrigation_manager') && string(fieldFarmId(fieldId)) in myFarmIds());
    }
    // The schedule itself — same as above, plus an irrigator whose profile
    // has canEditSchedule set, scoped to their own assigned farm(s) only.
    function canEditSchedule(fieldId) {
      let role = myRole();
      return canEditFarmData(fieldId)
        || (role == 'irrigator' && myData().canEditSchedule == true && string(fieldFarmId(fieldId)) in myFarmIds());
    }
    // Each person can read their own user record; an Admin or Owner can
    // read and write anyone's (that's what powers the Users tab's team
    // list). Nobody else can create or edit a user record — this is what
    // stops someone from writing their own document and handing themselves
    // a different role. Account creation itself happens through the
    // createUser Cloud Function (needed so creating someone else's login
    // doesn't sign the admin's own browser into that new account).
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdminOrOwner());
      allow write: if signedIn() && isAdminOrOwner();
    }
    // Reference data synced from Agworld. Any signed-in person can view it;
    // only the sync Cloud Functions write it, and those use an Admin key
    // that bypasses these rules entirely — so this doesn't affect them.
    match /farms/{farmId} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /seasons/{seasonId} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /fields/{fieldId} {
      allow read: if isStaff();
      allow write: if false;
      match /seasons/{seasonId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }
    // Collection-group rule: needed specifically because App.jsx queries
    // across every field's "seasons" subcollection at once (a
    // collectionGroup query) to build the season-filtered field list.
    // A rule scoped to one exact nested path (like fields/{fieldId}/seasons/{seasonId}
    // above) does NOT satisfy a collectionGroup query — Firestore requires
    // a rule using the {path=**} wildcard for that. This rule only adds
    // read permission; it doesn't loosen anything else.
    match /{path=**}/seasons/{seasonId} {
      allow read: if isStaff();
      allow write: if false;
    }
    // Sensor data from ChirpStack. Same pattern — the webhook Cloud
    // Function writes this with an Admin key; the app only ever reads it
    // (Live Data tab).
    match /devices/{deviceId} {
      allow read: if signedIn() && hasModule('irrigation');
      allow write: if false;
      match /readings/{readingId} {
        allow read: if signedIn() && hasModule('irrigation');
        allow write: if false;
      }
    }
    // Pivot status from BaseStation3, and the mapping linking each pivot
    // to its AgWorld field. Same pattern — the sync Cloud Function writes
    // these with an Admin key; the app only ever reads them.
    match /pivots/{pivotId} {
      allow read: if signedIn() && hasModule('irrigation');
      allow write: if false;
    }
    match /pivotFieldMapping/{mappingId} {
      allow read: if signedIn() && hasModule('irrigation');
      allow write: if false;
    }
    // Weekly pivot run-time log (wet / dry / no-signal hours per pivot per
    // week), written every 10 minutes by the pivot watcher with an Admin key.
    // Feeds the Applied inches column; the app only reads it. The helper
    // collection pivotWetLogState (the watcher's own bookkeeping) has no rule,
    // so it stays closed to the app.
    match /pivotWetLog/{recordId} {
      allow read: if signedIn() && hasModule('irrigation');
      allow write: if false;
    }
    // Soil/petiole/nematode/compost sample data, synced hourly from
    // Stukenholtz by a Cloud Function using an Admin key (bypasses these
    // rules for writes). Read access is scoped to canViewAgronomy(),
    // unlike the read-everything pattern above - this is the Agronomy
    // module's own access boundary.
    match /samples/{sampleId} {
      allow read: if signedIn() && canViewAgronomy() && hasModule('agronomy');
      allow write: if false;
    }
    match /syncState/{document} {
      allow read: if signedIn() && canViewAgronomy() && hasModule('agronomy');
      allow write: if false;
    }
    // Agronomy "Targets" tab reference data - the flat fallback ranges
    // (agronomyCriteria/flatTargets) and the per-crop/variety weekly N Rec
    // + target curves (agronomyCurves/{cropKey}, cropKey either "POTATO" or
    // "POTATO::VARIETY NAME" for a variety-specific override). Same read
    // gate as samples/syncState above. Writes always go through the
    // updateAgronomyCriteria Cloud Function (requireAdminOrOwner, using an
    // Admin key that bypasses these rules), never directly from the
    // browser - that's what lets editing be restricted to Admin/Owner
    // without duplicating a stricter role check here.
    match /agronomyCriteria/{document} {
      allow read: if signedIn() && canViewAgronomy() && hasModule('agronomy');
      allow write: if false;
    }
    match /agronomyCurves/{cropKey} {
      allow read: if signedIn() && canViewAgronomy() && hasModule('agronomy');
      allow write: if false;
    }
    // Agworld scouting report rows (Weekly Dig: field moisture %, tuber set,
    // etc.) uploaded from the Agronomy "Scouting" tab. Same read gate as
    // samples. Writes only happen through the importScoutingReport /
    // assignScoutingLocation Cloud Functions (Admin key, bypasses these
    // rules), never directly from the browser.
    match /scoutingObservations/{observationId} {
      allow read: if signedIn() && canViewAgronomy() && hasModule('agronomy');
      allow write: if false;
    }
    // Nitrogen applied per field per Agworld activity (lbs N/ac), written by
    // the syncNitrogenApplications function (Admin SDK). Same read gate.
    match /nApplications/{docId} {
      allow read: if signedIn() && canViewAgronomy() && hasModule('agronomy');
      allow write: if false;
    }
    // Pivot profiles: sprinkler package reference (metadata only — the PDF
    // itself lives in Storage, see storage.rules), current GPM, and the
    // stuck-pivot alert threshold. Deliberately NOT farm-scoped like
    // canEditFarmData() — a single pivot can serve more than one field
    // (and therefore, in principle, span farm boundaries; Mietzner Middle
    // already does this across two fields on the same farm), and some
    // pivots have no field mapped at all (Mills). Simpler and safer for
    // now to gate on role alone; can be tightened once/if a pivot's farm
    // ownership needs to be unambiguous.
    //
    // The GPM that feeds scheduled inches (currentGpm) can only be set one
    // of three ways, so a number can't just be typed in or left over:
    //   1. 'package'  - confirmed straight from the number the package
    //      reader (scanSprinklerPackage) read off the PDF that is on the
    //      profile right now.
    //   2. 'manual'   - typed by hand, only while "No package printout
    //      available" is ticked and no package is on file.
    //   3. 'typedFromPackage' - typed off the PDF when a package is on file
    //      but the reader couldn't find a GPM in it.
    // packageScan is written only by the reader (it uses the admin SDK,
    // which skips these rules), so nobody can fake a scan result.
    function pivotProfileEditor() {
      return signedIn() && hasModule('irrigation') && (isAdminOrOwner() || myRole() == 'farm_manager' || myRole() == 'irrigation_manager');
    }
    function gpmWriteOk() {
      let n = request.resource.data;
      return n.get('currentGpm', null) == (resource == null ? null : resource.data.get('currentGpm', null))
        || (
          n.get('currentGpm', null) is number && n.currentGpm > 0 && (
            (
              n.get('gpmSource', '') == 'package'
              && n.get('packageScan', null) != null
              && n.get('sprinklerPackage', null) != null
              && n.packageScan.get('status', '') == 'read'
              && n.packageScan.get('gpm', null) == n.currentGpm
              && n.packageScan.get('storagePath', '') == n.sprinklerPackage.get('storagePath', null)
            ) || (
              n.get('gpmSource', '') == 'manual'
              && n.get('noPackagePrintout', false) == true
              && n.get('sprinklerPackage', null) == null
            ) || (
              n.get('gpmSource', '') == 'typedFromPackage'
              && n.get('packageScan', null) != null
              && n.get('sprinklerPackage', null) != null
              && n.packageScan.get('status', '') in ['noGpm', 'failed']
              && n.packageScan.get('storagePath', '') == n.sprinklerPackage.get('storagePath', null)
            )
          )
        );
    }
    function packageScanUntouched() {
      return request.resource.data.get('packageScan', null) == (resource == null ? null : resource.data.get('packageScan', null));
    }
    // Removing a package (the current one or a previous one) takes farm
    // manager or above. Irrigation managers can still upload and replace.
    function pkgCount(d) {
      return (d.get('sprinklerPackage', null) != null ? 1 : 0) + d.get('sprinklerPackageHistory', []).size();
    }
    function packageDeleteOk() {
      let before = resource == null ? 0 : pkgCount(resource.data);
      return pkgCount(request.resource.data) >= before || isAdminOrOwner() || myRole() == 'farm_manager';
    }
    match /pivotProfiles/{pivotId} {
      allow read: if signedIn() && hasModule('irrigation');
      allow create, update: if pivotProfileEditor() && gpmWriteOk() && packageScanUntouched() && packageDeleteOk();
      allow delete: if pivotProfileEditor();
    }
    // The actual irrigation schedule. Everyone signed in can view it (read
    // access isn't farm-scoped — farm/irrigation managers are explicitly
    // allowed to view farms outside their own, and locking irrigators to
    // their farm is handled client-side via the farm picker rather than
    // here). Editing is scoped per-farm via canEditSchedule() above.
    match /weeks/{weekId}/events/{fieldId} {
      allow read: if signedIn() && hasModule('irrigation');
      allow write: if signedIn() && hasModule('irrigation') && canEditSchedule(fieldId);
    }
    // AgriMet weather for the ET column: ETr by day and the daily forecast
    // per station, written only by the archiveAgrimetNightly function. The
    // raw daily copies (agrimetRaw) are server-only and have no rule, so
    // the app can't read them.
    match /agrimetDaily/{stationId} {
      allow read: if signedIn() && hasModule('irrigation');
      allow write: if false;
    }
    match /fieldSettings/{fieldId} {
      allow read: if signedIn() && hasModule('irrigation');
      allow write: if signedIn() && hasModule('irrigation') && canEditFarmData(fieldId);
    }
    // Agri-Stor live conditions for Potato Storage — the "latest reading"
    // doc per bin, plus its history subcollection (Plenum/Return
    // air/Panel Δ T trend, see syncAgristorReadings in index.js and
    // useAgristorReading/useAgristorHistory in PotatoStorage.jsx). Same
    // pattern as devices/ above: the sync Cloud Function writes this with
    // an Admin key that bypasses these rules, so "write: false" here only
    // blocks the browser, never the sync job. This collection previously
    // had no rule at all, which Firestore defaults to denying — that's
    // what was causing "Missing or insufficient permissions" in the app.
    match /agristorReadings/{binId} {
      allow read: if signedIn() && hasModule('potato-storage');
      allow write: if false;
      match /history/{historyId} {
        allow read: if signedIn() && hasModule('potato-storage');
        allow write: if false;
      }
    }
    // IVI/Centurion live conditions for Potato Storage — same pattern and
    // same reasoning as agristorReadings directly above: the sync Cloud
    // Function (syncIviReadings in index.js) writes this with an Admin key
    // that bypasses these rules, so "write: false" only blocks the
    // browser, never the sync job. One doc per linked panel, keyed by the
    // panel's own GUID, plus an hourly history subcollection (supply/
    // return/Δ T over time) matching agristorReadings/history's shape.
    match /iviReadings/{panelId} {
      allow read: if signedIn() && hasModule('potato-storage');
      allow write: if false;
      match /history/{historyId} {
        allow read: if signedIn() && hasModule('potato-storage');
        allow write: if false;
      }
    }
    // Potato Storage module. All of its data (bays, seasons, tube checks,
    // cwt runs, temp logs, Sprout Nip applications, product/customer/variety
    // rosters, etc.) lives in this single collection, one document per key.
    // Gated by the 'potato-storage' module (see hasModule above): anyone
    // whose profile has no modules list keeps access as before; anyone with
    // a list needs 'potato-storage' in it.
    // Customer portal: one filtered copy per customer, published by staff
    // sessions from Potato Storage (see publishCustomerViews). A customer
    // login can read only the docs whose key is on their own profile's
    // `customerKeys` list; staff with the Potato Storage module can read and
    // write them all (writes include deleting a view for a removed customer).
    match /customerViews/{key} {
      allow read: if signedIn() && (hasModule('potato-storage') || (isCustomer() && key in myData().get('customerKeys', [])));
      allow write: if signedIn() && hasModule('potato-storage');
    }
    // Contracts module — processor / beet-share / corn / onion contracts
    // and which whole fields are allocated to each (see Contracts.jsx).
    // Same audience as Agronomy: Admin, Owner and Farm manager can read
    // (gated by the 'contracts' module like everything else); only Admin
    // and Owner can write. contractAllocations docs are keyed
    // "{seasonId}__{fieldId}", so a field can only be on one contract per
    // season.
    match /contracts/{contractId} {
      allow read: if signedIn() && canViewContracts() && hasModule('contracts');
      allow write: if signedIn() && isAdminOrOwner();
    }
    match /contractAllocations/{allocationId} {
      allow read: if signedIn() && canViewContracts() && hasModule('contracts');
      allow write: if signedIn() && isAdminOrOwner();
    }
    // USDA satellite crop history per Agworld field (Contracts > Rotation),
    // written only by the satelliteRotation Cloud Functions (Admin key).
    // fieldBoundaries (field outlines from the Agworld sync) has no rule on
    // purpose: only the Cloud Functions read it, so the default deny applies.
    // Field history links (Contracts > Rotation, Yields > Field history):
    // which old field names a current field takes history from. Same
    // audience as Contracts/Yields to read; Admin/Owner edit. The map-based
    // suggestions (_suggestions) are written by the suggestFieldLineageByMap
    // Cloud Function with an Admin key.
    match /fieldLineage/{childKey} {
      allow read: if signedIn() && canViewContracts() && (hasModule('contracts') || hasModule('yields'));
      allow write: if signedIn() && isAdminOrOwner();
    }
    match /rotationSat/{fieldId} {
      allow read: if signedIn() && canViewContracts() && hasModule('contracts');
      allow write: if false;
    }
    // Yield History module (Yields.jsx). One doc per field-year, keyed
    // "{FIELDKEY}__{YEAR}". Rows come from the yield workbook (imported in
    // the browser by Admin/Owner) and from the nightly Agworld sync (Admin
    // key, bypasses these rules). Same read audience as Agronomy.
    match /yieldHistory/{recordId} {
      allow read: if signedIn() && canViewContracts() && hasModule('yields');
      allow write: if signedIn() && isAdminOrOwner();
    }
    // Yields module settings: storage (tare %, ignored storage piles) and
    // storageStatus (last Potato Storage -> yield sync, written by the
    // storageYields Cloud Functions with an Admin key).
    match /yieldSettings/{settingId} {
      allow read: if signedIn() && canViewContracts() && hasModule('yields');
      allow write: if signedIn() && isAdminOrOwner();
    }
    // Harvest Schedule module (Harvest.jsx). harvestPlans/{seasonId} holds
    // the settings, harvestFields/{seasonId}__{key} one doc per field on the
    // plan, harvestLogs/{seasonId}__{team}__{date}__{AM|PM} the half-day
    // progress logs. Admin, Owner and Farm manager read and write.
    match /harvestPlans/{planId} {
      allow read, write: if signedIn() && canViewContracts() && hasModule('harvest');
    }
    match /harvestFields/{docId} {
      allow read, write: if signedIn() && canViewContracts() && hasModule('harvest');
    }
    match /harvestLogs/{docId} {
      allow read, write: if signedIn() && canViewContracts() && hasModule('harvest');
    }
    // Potato Seed module (Seed.jsx). Every staff login with the 'seed'
    // module (incl. Potato planting staff) can enter tickets and read the
    // live inventory; contracts, settings, edits and deletes are Admin,
    // Owner and Farm manager. Staff may only flip a pickup to "unloaded".
    function canSeed() {
      return isStaff() && hasModule('seed');
    }
    function canSeedManage() {
      return canSeed() && (isAdminOrOwner() || myRole() == 'farm_manager');
    }
    match /seedContracts/{id} {
      allow read: if canSeed();
      allow write: if canSeedManage();
    }
    match /seedSettings/{id} {
      allow read: if canSeed();
      allow write: if canSeedManage();
    }
    match /seedLotClose/{id} {
      allow read: if canSeed();
      allow write: if canSeedManage();
    }
    match /seedTrucks/{id} {
      allow read, create, update: if canSeed();
      allow delete: if canSeedManage();
    }
    match /seedTickets/{id} {
      allow read, create: if canSeed();
      allow update: if canSeedManage() || (canSeed() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'unloadedAt', 'unloadedBy']));
      allow delete: if canSeedManage();
    }
    match /seedPhotos/{id} {
      allow read, create: if canSeed();
      allow update, delete: if canSeedManage();
    }
    // Farm Map module (FarmMap.jsx): field outlines, points (cellars, shops,
    // dumps…) and the imported Main Field Plan rows. Any staff login with
    // the 'map' module can view (Farm managers included); only Admin and
    // Owner write, for now.
    function canMap() {
      return isStaff() && hasModule('map');
    }
    function canMapEdit() {
      return canMap() && isAdminOrOwner();
    }
    match /farmFields/{id} {
      allow read: if canMap();
      allow write: if canMapEdit();
    }
    match /farmPoints/{id} {
      allow read: if canMap();
      allow write: if canMapEdit();
    }
    match /fieldPlanRows/{id} {
      allow read: if canMap();
      allow write: if canMapEdit();
    }
    match /potatoStorage/{document} {
      allow read, write: if signedIn() && hasModule('potato-storage');
    }
  }
}
