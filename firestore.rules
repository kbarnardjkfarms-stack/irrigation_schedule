rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Role/permission helpers -------------------------------------
    // A single source of truth for "who is this person and what can they
    // touch," used by every match block below instead of repeating raw
    // get() calls. Roles, top-down: admin, owner, farm_manager,
    // irrigation_manager, irrigator. Admin/owner can view and edit
    // everything. Farm/irrigation managers can edit only the farm(s) on
    // their profile, view-only elsewhere. Irrigators are view-only by
    // default, unless their profile has canEditSchedule set — that grants
    // schedule editing (not field settings) on their assigned farm(s) only.
    function signedIn() {
      return request.auth != null;
    }
    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myRole() {
      return myData().role;
    }
    function isAdminOrOwner() {
      return myRole() == 'admin' || myRole() == 'owner';
    }
    // Agronomy module - Admin, Owner, or Farm manager only. Narrower than
    // isAdminOrOwner() alone, and deliberately excludes Irrigation manager
    // and Irrigator, unlike the farm-scoped functions below.
    function canViewAgronomy() {
      return isAdminOrOwner() || myRole() == 'farm_manager';
    }
    function myFarmIds() {
      return myData().farmIds;
    }
    function fieldFarmId(fieldId) {
      return get(/databases/$(database)/documents/fields/$(fieldId)).data.farmId;
    }
    // Field settings (GPM, etc.) — structural/managerial data. Admin,
    // owner, or a farm/irrigation manager on that specific farm. Never
    // granted by the irrigator schedule-edit override.
    function canEditFarmData(fieldId) {
      let role = myRole();
      return isAdminOrOwner()
        || ((role == 'farm_manager' || role == 'irrigation_manager') && string(fieldFarmId(fieldId)) in myFarmIds());
    }
    // The schedule itself — same as above, plus an irrigator whose profile
    // has canEditSchedule set, scoped to their own assigned farm(s) only.
    function canEditSchedule(fieldId) {
      let role = myRole();
      return canEditFarmData(fieldId)
        || (role == 'irrigator' && myData().canEditSchedule == true && string(fieldFarmId(fieldId)) in myFarmIds());
    }
    // Each person can read their own user record; an Admin or Owner can
    // read and write anyone's (that's what powers the Users tab's team
    // list). Nobody else can create or edit a user record — this is what
    // stops someone from writing their own document and handing themselves
    // a different role. Account creation itself happens through the
    // createUser Cloud Function (needed so creating someone else's login
    // doesn't sign the admin's own browser into that new account).
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdminOrOwner());
      allow write: if signedIn() && isAdminOrOwner();
    }
    // Reference data synced from Agworld. Any signed-in person can view it;
    // only the sync Cloud Functions write it, and those use an Admin key
    // that bypasses these rules entirely — so this doesn't affect them.
    match /farms/{farmId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /seasons/{seasonId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /fields/{fieldId} {
      allow read: if signedIn();
      allow write: if false;
      match /seasons/{seasonId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
    // Collection-group rule: needed specifically because App.jsx queries
    // across every field's "seasons" subcollection at once (a
    // collectionGroup query) to build the season-filtered field list.
    // A rule scoped to one exact nested path (like fields/{fieldId}/seasons/{seasonId}
    // above) does NOT satisfy a collectionGroup query — Firestore requires
    // a rule using the {path=**} wildcard for that. This rule only adds
    // read permission; it doesn't loosen anything else.
    match /{path=**}/seasons/{seasonId} {
      allow read: if signedIn();
      allow write: if false;
    }
    // Sensor data from ChirpStack. Same pattern — the webhook Cloud
    // Function writes this with an Admin key; the app only ever reads it
    // (Live Data tab).
    match /devices/{deviceId} {
      allow read: if signedIn();
      allow write: if false;
      match /readings/{readingId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
    // Pivot status from BaseStation3, and the mapping linking each pivot
    // to its AgWorld field. Same pattern — the sync Cloud Function writes
    // these with an Admin key; the app only ever reads them.
    match /pivots/{pivotId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /pivotFieldMapping/{mappingId} {
      allow read: if signedIn();
      allow write: if false;
    }
    // Soil/petiole/nematode/compost sample data, synced hourly from
    // Stukenholtz by a Cloud Function using an Admin key (bypasses these
    // rules for writes). Read access is scoped to canViewAgronomy(),
    // unlike the read-everything pattern above - this is the Agronomy
    // module's own access boundary.
    match /samples/{sampleId} {
      allow read: if signedIn() && canViewAgronomy();
      allow write: if false;
    }
    match /syncState/{document} {
      allow read: if signedIn() && canViewAgronomy();
      allow write: if false;
    }
    // Pivot profiles: sprinkler package reference (metadata only — the PDF
    // itself lives in Storage, see storage.rules), current GPM, and the
    // stuck-pivot alert threshold. Deliberately NOT farm-scoped like
    // canEditFarmData() — a single pivot can serve more than one field
    // (and therefore, in principle, span farm boundaries; Mietzner Middle
    // already does this across two fields on the same farm), and some
    // pivots have no field mapped at all (Mills). Simpler and safer for
    // now to gate on role alone; can be tightened once/if a pivot's farm
    // ownership needs to be unambiguous.
    match /pivotProfiles/{pivotId} {
      allow read: if signedIn();
      allow write: if signedIn() && (isAdminOrOwner() || myRole() == 'farm_manager' || myRole() == 'irrigation_manager');
    }
    // The actual irrigation schedule. Everyone signed in can view it (read
    // access isn't farm-scoped — farm/irrigation managers are explicitly
    // allowed to view farms outside their own, and locking irrigators to
    // their farm is handled client-side via the farm picker rather than
    // here). Editing is scoped per-farm via canEditSchedule() above.
    match /weeks/{weekId}/events/{fieldId} {
      allow read: if signedIn();
      allow write: if signedIn() && canEditSchedule(fieldId);
    }
    match /fieldSettings/{fieldId} {
      allow read: if signedIn();
      allow write: if signedIn() && canEditFarmData(fieldId);
    }
    // Agri-Stor live conditions for Potato Storage — the "latest reading"
    // doc per bin, plus its history subcollection (Plenum/Return
    // air/Panel Δ T trend, see syncAgristorReadings in index.js and
    // useAgristorReading/useAgristorHistory in PotatoStorage.jsx). Same
    // pattern as devices/ above: the sync Cloud Function writes this with
    // an Admin key that bypasses these rules, so "write: false" here only
    // blocks the browser, never the sync job. This collection previously
    // had no rule at all, which Firestore defaults to denying — that's
    // what was causing "Missing or insufficient permissions" in the app.
    match /agristorReadings/{binId} {
      allow read: if signedIn();
      allow write: if false;
      match /history/{historyId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
    // Potato Storage module. All of its data (bays, seasons, tube checks,
    // cwt runs, temp logs, Sprout Nip applications, product/customer/variety
    // rosters, etc.) lives in this single collection, one document per key.
    // Any signed-in person can read/write — same access model as before;
    // the new role system doesn't reach into this module yet.
    match /potatoStorage/{document} {
      allow read, write: if signedIn();
    }
  }
}
